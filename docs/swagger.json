{
    "swagger": "2.0",
    "info": {
        "description": "## Sistem Pengaduan \u0026 Tracking Fasilitas Kampus\nAplikasi ini mengelola seluruh siklus pengaduan kerusakan fasilitas, mulai dari pelaporan oleh mahasiswa/dosen/staff, penugasan dan pengerjaan oleh petugas, hingga evaluasi dan pemantauan oleh Admin.\n\n**Role yang tersedia**: mahasiswa, dosen, staff, petugas, admin\n\n**Alur status laporan**: ditinjau → diterima → diproses → selesai (atau ditolak)\n\n**Autentikasi**: Gunakan endpoint `/api/login` untuk mendapatkan JWT token, lalu klik tombol **Authorize** dan masukkan `Bearer \u003ctoken\u003e`.",
        "title": "SiLapor API",
        "contact": {
            "name": "Tim Pengembang SiLapor"
        },
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/changepassword": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Mengubah password user yang sedang login. Password baru wajib memenuhi kriteria kuat (min 8 karakter, huruf besar, huruf kecil, angka, dan simbol).",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Ubah password sendiri",
                "parameters": [
                    {
                        "description": "Data password lama dan baru",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.ChangePasswordRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/dashboard/admin": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Mengambil rekapitulasi data statistik laporan (total, belum selesai, terlambat, eskalasi prioritas tinggi) dan statistik per kategori. Hanya dapat diakses oleh admin.",
                "produces": ["application/json"],
                "tags": ["Dashboard"],
                "summary": "Statistik Dashboard Admin",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {"$ref": "#/definitions/model.Response"},
                                {"type": "object", "properties": {"data": {"$ref": "#/definitions/handler.DashboardResponse"}}}
                            ]
                        }
                    },
                    "403": {"description": "Forbidden", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/forgot-password": {
            "post": {
                "description": "Memulai proses reset password dengan mengirimkan kode OTP 6 digit ke email terdaftar.\nAkun harus sudah memiliki email pemulihan. Akun admin tidak dapat menggunakan fitur ini.\nOTP berlaku selama 15 menit.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Lupa password - kirim OTP",
                "parameters": [
                    {
                        "description": "Username atau email terdaftar",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.ForgotPasswordRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OTP berhasil dikirim ke email", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Akun belum memiliki email pemulihan", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Akun admin tidak dapat menggunakan fitur ini", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Pengguna tidak ditemukan", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/kategori": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Mengambil semua kategori fasilitas beserta data petugas yang bertanggung jawab. Dapat diakses oleh semua role yang sudah login.",
                "produces": ["application/json"],
                "tags": ["Kategori"],
                "summary": "Daftar kategori fasilitas",
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            },
            "post": {
                "security": [{"BearerAuth": []}],
                "description": "Admin menambah kategori fasilitas baru. Dapat sekaligus menugaskan petugas dan mengatur SLA.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Kategori"],
                "summary": "Tambah kategori baru (Admin)",
                "parameters": [
                    {
                        "description": "Data kategori",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.KategoriRequest"}
                    }
                ],
                "responses": {
                    "201": {"description": "Created", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/kategori/{id}": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Admin mengubah data kategori fasilitas, termasuk penugasan petugas dan SLA.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Kategori"],
                "summary": "Ubah kategori (Admin)",
                "parameters": [
                    {"description": "Kategori ID", "name": "id", "in": "path", "required": true, "type": "integer"},
                    {
                        "description": "Data kategori",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.KategoriRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            },
            "delete": {
                "security": [{"BearerAuth": []}],
                "description": "Admin menghapus kategori fasilitas berdasarkan ID.",
                "produces": ["application/json"],
                "tags": ["Kategori"],
                "summary": "Hapus kategori (Admin)",
                "parameters": [
                    {"description": "Kategori ID", "name": "id", "in": "path", "required": true, "type": "integer"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/laporan": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Mengambil daftar laporan sesuai role user yang login:\n- mahasiswa/dosen/staff: hanya laporan milik sendiri\n- petugas: laporan yang ditugaskan kepadanya\n- admin: semua laporan",
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Daftar laporan",
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            },
            "post": {
                "security": [{"BearerAuth": []}],
                "description": "Membuat laporan kerusakan fasilitas baru. Dapat dilakukan oleh mahasiswa, dosen, staff, dan admin. Upload foto bersifat opsional.",
                "consumes": ["multipart/form-data"],
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Buat laporan baru",
                "parameters": [
                    {"description": "Penjelasan kerusakan", "name": "deskripsi", "in": "formData", "required": true, "type": "string"},
                    {"description": "Lokasi kerusakan (contoh: Gedung A Lantai 2)", "name": "lokasi", "in": "formData", "required": true, "type": "string"},
                    {"description": "ID kategori fasilitas", "name": "kategori_id", "in": "formData", "required": true, "type": "integer"},
                    {"description": "Foto bukti kerusakan (opsional)", "name": "bukti", "in": "formData", "type": "file"}
                ],
                "responses": {
                    "201": {"description": "Created", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - role petugas tidak dapat membuat laporan", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/laporan/{id}": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Mengambil detail satu laporan berdasarkan ID beserta data pelapor, kategori, petugas, dan riwayat status.",
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Detail laporan",
                "parameters": [
                    {"description": "Laporan ID", "name": "id", "in": "path", "required": true, "type": "integer"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            },
            "delete": {
                "security": [{"BearerAuth": []}],
                "description": "Admin menghapus laporan berdasarkan ID. Hanya dapat dilakukan oleh admin.",
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Hapus laporan (Admin)",
                "parameters": [
                    {"description": "Laporan ID", "name": "id", "in": "path", "required": true, "type": "integer"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/laporan/{id}/admin-update": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Admin dapat merubah tingkat prioritas laporan, menunjuk ulang petugas, atau mengatur tenggat waktu khusus (SLA kustom). Hanya dapat dilakukan oleh admin.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Update pengaturan laporan (Admin)",
                "parameters": [
                    {"description": "Laporan ID", "name": "id", "in": "path", "required": true, "type": "integer"},
                    {
                        "description": "Data prioritas, penugasan, dan tenggat",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.AdminUpdateLaporanRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/laporan/{id}/rating": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Mahasiswa, dosen, atau staff memberikan rating (1-5) dan ulasan pada laporan yang sudah berstatus \"selesai\". Hanya pelapor yang bisa memberi rating pada laporannya sendiri.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Beri rating laporan (Pelapor)",
                "parameters": [
                    {"description": "Laporan ID", "name": "id", "in": "path", "required": true, "type": "integer"},
                    {
                        "description": "Rating dan feedback",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.RatingRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan pelapor atau laporan belum selesai", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/laporan/{id}/riwayat": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Melihat timeline riwayat perubahan status laporan. Dapat diakses oleh semua role yang sudah login.",
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Riwayat status laporan",
                "parameters": [
                    {"description": "Laporan ID", "name": "id", "in": "path", "required": true, "type": "integer"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/laporan/{id}/status": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Admin atau petugas mengubah status laporan. Alur status: ditinjau → diterima → diproses → selesai (atau ditolak).\nJika status \"selesai\", upload bukti foto wajib dilakukan.\nJika status \"ditolak\", field alasan_penolakan wajib diisi.",
                "consumes": ["multipart/form-data"],
                "produces": ["application/json"],
                "tags": ["Laporan"],
                "summary": "Ubah status laporan (Admin/Petugas)",
                "parameters": [
                    {"description": "Laporan ID", "name": "id", "in": "path", "required": true, "type": "integer"},
                    {"description": "Status baru: ditinjau / diterima / diproses / selesai / ditolak", "name": "status", "in": "formData", "required": true, "type": "string"},
                    {"description": "Alasan penolakan (wajib jika status ditolak)", "name": "alasan_penolakan", "in": "formData", "type": "string"},
                    {"description": "Bukti penyelesaian foto (wajib jika status selesai)", "name": "bukti_selesai", "in": "formData", "type": "file"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin atau petugas", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/login": {
            "post": {
                "description": "Login dengan username dan password, mendapatkan JWT token yang berlaku 24 jam. Gunakan token ini sebagai Bearer token di header Authorization untuk endpoint yang memerlukan autentikasi.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Login user",
                "parameters": [
                    {
                        "description": "Data login",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.LoginRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Username atau password salah", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/notifikasi": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Mengambil daftar notifikasi milik pengguna yang sedang login. Dapat diakses oleh semua role.",
                "produces": ["application/json"],
                "tags": ["Notifikasi"],
                "summary": "Daftar notifikasi",
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/notifikasi/{id}/read": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Menandai satu notifikasi spesifik milik pengguna yang login sebagai sudah dibaca.",
                "produces": ["application/json"],
                "tags": ["Notifikasi"],
                "summary": "Tandai notifikasi dibaca",
                "parameters": [
                    {"description": "Notifikasi ID", "name": "id", "in": "path", "required": true, "type": "integer"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Not Found", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/notifikasi/read-all": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Menandai seluruh notifikasi milik pengguna yang sedang login sebagai sudah dibaca sekaligus.",
                "produces": ["application/json"],
                "tags": ["Notifikasi"],
                "summary": "Tandai semua notifikasi dibaca",
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/profile/email": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Menambahkan atau mengubah email pemulihan akun. Email ini digunakan untuk fitur lupa password. Dapat dilakukan oleh semua role yang sudah login.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Update email pemulihan akun",
                "parameters": [
                    {
                        "description": "Email baru",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.UpdateProfileRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Unauthorized", "schema": {"$ref": "#/definitions/model.Response"}},
                    "409": {"description": "Email sudah digunakan akun lain", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/register": {
            "post": {
                "description": "Mendaftarkan user baru ke sistem. Role default adalah \"mahasiswa\".\nPassword wajib memenuhi kriteria kuat: min 8 karakter, huruf besar, huruf kecil, angka, dan simbol.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Register user baru",
                "parameters": [
                    {
                        "description": "Data registrasi",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.RegisterRequest"}
                    }
                ],
                "responses": {
                    "201": {"description": "Created", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "409": {"description": "Username atau email sudah digunakan", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/reset-password": {
            "post": {
                "description": "Menetapkan password baru menggunakan reset_token yang diperoleh dari endpoint /api/verify-otp.\nToken berlaku 15 menit. Password baru harus memenuhi kriteria kuat.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Reset password baru",
                "parameters": [
                    {
                        "description": "Reset token dan password baru",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.ResetPasswordRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "Password berhasil direset", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Password tidak memenuhi kriteria", "schema": {"$ref": "#/definitions/model.Response"}},
                    "401": {"description": "Token tidak valid atau kedaluwarsa", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/users": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "Mengambil semua data pengguna beserta kategori yang ditangani (untuk petugas). Hanya dapat diakses oleh admin.",
                "produces": ["application/json"],
                "tags": ["Users"],
                "summary": "Daftar semua pengguna (Admin)",
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "500": {"description": "Internal Server Error", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            },
            "post": {
                "security": [{"BearerAuth": []}],
                "description": "Admin membuat akun pengguna baru dengan role yang dapat ditentukan.\nRole yang tersedia: mahasiswa, dosen, staff, petugas, admin. Default role adalah \"petugas\".\nPassword wajib memenuhi kriteria kuat.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Users"],
                "summary": "Buat pengguna baru (Admin)",
                "parameters": [
                    {
                        "description": "Data pengguna baru",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.RegisterRequest"}
                    }
                ],
                "responses": {
                    "201": {"description": "Created", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "409": {"description": "Username atau email sudah digunakan", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/users/{id}": {
            "delete": {
                "security": [{"BearerAuth": []}],
                "description": "Admin menghapus akun pengguna berdasarkan ID. Hanya dapat dilakukan oleh admin.",
                "produces": ["application/json"],
                "tags": ["Users"],
                "summary": "Hapus pengguna (Admin)",
                "parameters": [
                    {"description": "User ID", "name": "id", "in": "path", "required": true, "type": "integer"}
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "ID tidak valid", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "500": {"description": "Internal Server Error", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/users/{id}/reset-password": {
            "put": {
                "security": [{"BearerAuth": []}],
                "description": "Admin mereset password pengguna secara manual, misalnya jika pengguna tidak memiliki email pemulihan. Password baru wajib memenuhi kriteria kuat.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Users"],
                "summary": "Reset password pengguna (Admin)",
                "parameters": [
                    {"description": "User ID", "name": "id", "in": "path", "required": true, "type": "integer"},
                    {
                        "description": "Password baru",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.AdminResetPasswordRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "OK", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "Bad Request", "schema": {"$ref": "#/definitions/model.Response"}},
                    "403": {"description": "Forbidden - bukan admin", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Pengguna tidak ditemukan", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        },
        "/api/verify-otp": {
            "post": {
                "description": "Memverifikasi kode OTP yang dikirim ke email. Jika valid, mengembalikan reset_token (JWT 15 menit)\nyang digunakan pada endpoint /api/reset-password untuk menetapkan password baru.",
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Auth"],
                "summary": "Verifikasi OTP",
                "parameters": [
                    {
                        "description": "Identifier dan kode OTP",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {"$ref": "#/definitions/model.VerifyOTPRequest"}
                    }
                ],
                "responses": {
                    "200": {"description": "Verifikasi berhasil, mengembalikan reset_token", "schema": {"$ref": "#/definitions/model.Response"}},
                    "400": {"description": "OTP salah atau kedaluwarsa", "schema": {"$ref": "#/definitions/model.Response"}},
                    "404": {"description": "Pengguna tidak ditemukan", "schema": {"$ref": "#/definitions/model.Response"}}
                }
            }
        }
    },
